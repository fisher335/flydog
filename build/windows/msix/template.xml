<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="neiwangtong.exe"
        Arguments=""
        InstallLocation="C:\Program Files\内网通">
    </Installer>
    <PackageInformation
        PackageName="内网通"
        PackageDisplayName="内网通"
        PublisherName="CN=内网通"
        PublisherDisplayName="内网通"
        Version="0.1.0.0"
        PackageDescription="局域网通讯与文件传输">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.neiwangtong.app"
                Description="局域网通讯与文件传输"
                DisplayName="内网通"
                ExecutableName="neiwangtong.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="zh-cn" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>内网通</DisplayName>
            <PublisherDisplayName>内网通</PublisherDisplayName>
            <Description>局域网通讯与文件传输</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="neiwangtong.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
